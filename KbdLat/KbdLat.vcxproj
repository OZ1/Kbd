  <Target Name="IncrementFileVersion" AfterTargets="Build">
    <IncrementFileVersion Items="@(ResourceCompile)" Condition="'%(ResourceCompile.ExcludedFromBuild)'!='true'" />
  </Target>
  <UsingTask TaskName="IncrementFileVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Items ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
Regex rx = new(@"(^\s*FILEVERSION\s*(?:\d+\s*,\s*){3})(\d+)(\s*$)",
	RegexOptions.IgnorePatternWhitespace |
	RegexOptions.Singleline |
	RegexOptions.Multiline |
	RegexOptions.CultureInvariant);

byte[] bom = new byte[4];
foreach (var rc in Items)
{
	string original;
	Encoding encoding;
	using (FileStream fs = new(rc.ItemSpec, FileMode.Open))
	{
		encoding = fs.Read(bom, 0, bom.Length) switch
		{
			>= 4 when bom[0] == 0x00 && bom[1] == 0x00 && bom[2] == 0xFE && bom[3] == 0xFF => new UTF32Encoding(true, true),
			>= 4 when bom[0] == 0xFF && bom[1] == 0xFE && bom[2] == 0x00 && bom[3] == 0x00 => Encoding.UTF32,
			>= 3 when bom[0] == 0xEF && bom[1] == 0xBB && bom[2] == 0xBF => Encoding.UTF8,
			>= 2 when bom[0] == 0xFE && bom[1] == 0xFF => Encoding.BigEndianUnicode,
			>= 2 when bom[0] == 0xFF && bom[1] == 0xFE => Encoding.Unicode,
			>= 2 when bom[0] == 0 => Encoding.BigEndianUnicode,
			>= 2 when bom[1] == 0 => Encoding.Unicode,
			_ => Encoding.Default,
		};
		fs.Seek(0, SeekOrigin.Begin);

		using StreamReader f = new(fs, encoding, true);
		original = f.ReadToEnd();
		encoding = f.CurrentEncoding;
	}
	var incremented = rx.Replace(original, m => $"{m.Groups[1]}{uint.Parse(m.Groups[2].Value) + 1}{m.Groups[3]}");
	if (incremented.Equals(original, StringComparison.Ordinal)) continue;
	File.WriteAllText(rc.ItemSpec, incremented, encoding);
}]]></Code>
    </Task>
  </UsingTask>
